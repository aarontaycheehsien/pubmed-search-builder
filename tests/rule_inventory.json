      "guarded_by": "none"
    },
    {
      "id": "output.audit-iteration-sections",
      "rule": "audit-template.md owns scope, candidate, critic, revision, line-set, and PRISMA-S audit sections.",
      "canonical_owner": "references/audit-template.md",
      "assertions": [
