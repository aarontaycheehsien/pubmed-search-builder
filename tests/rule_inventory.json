      "pointer_locations": [
        "SKILL.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "tools.complete-loop-manifest",
      "rule": "mesh-and-pubmed-tools.md documents versioned scope/candidate/critic state and the combined manifest gate.",
      "canonical_owner": "references/mesh-and-pubmed-tools.md",
      "assertions": [
        "record-candidate-screen",
        "record-critic",
        "record-revision",
        "--require-complete-loop",
        "run_manifest.json"
      ],
      "pointer_locations": [
        "SKILL.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "wildcard.current-limits-and-proximity-exclusion",
      "rule": "wildcard-and-truncation.md owns PubMed wildcard limits and proximity exclusion.",
      "canonical_owner": "references/wildcard-and-truncation.md",
      "assertions": [
        "current pubmed wildcard limits",
        "at least 4 characters before the first wildcard",
        "256 wildcard operators per query",
        "truncation and proximity are mutually exclusive",
        "wildcard testing protocol"
      ],
      "pointer_locations": [
        "references/workflow.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "bramer.reciprocal-gap-analysis",
      "rule": "bramer-reciprocal-gap-analysis.md owns the conditional reciprocal gap check.",
      "canonical_owner": "references/bramer-reciprocal-gap-analysis.md",
      "assertions": [
        "(mesh/scr layer) not (text-word layer)",
        "(text-word layer) not (mesh/scr layer)",
        "reasoned waiver",
        "counts alone are not enough",
        "do not copy diagnostic `not` into the final strategy"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md",
        "references/mesh-and-pubmed-tools.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "filters.validated-sources-and-ovid-warning",
      "rule": "validated-methodological-filters-and-hedges.md owns validated filter sources and translation warnings.",
      "canonical_owner": "references/validated-methodological-filters-and-hedges.md",
      "assertions": [
        "cochrane highly sensitive search strategy",
        "mcmaster health information research unit",
        "issg search filters resource",
        "do not paste ovid syntax into pubmed",
