{
  "_about": {
    "purpose": "Machine-checkable inventory of the skill's canonical normative rules: which document owns each rule, and which documents must link to that owner.",
    "format_note": "JSON keeps the test standard-library-only."
  },
  "rules": [
    {
      "id": "workflow.scope-objective-critic-loop",
      "rule": "workflow.md owns the scope-first repeating build, validation, critic, and revision sequence.",
      "canonical_owner": "references/workflow.md",
      "assertions": [
        "stages 5-9 form a loop",
        "save `review_protocol_v1.json`",
        "repeat objective evidence, testing, validation, and critic review",
        "--require-complete-loop",
        "mesh does not replace free text",
        "free text does not replace mesh"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/concept-analysis-and-gating.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "concept.roles-fragility-admission",
      "rule": "concept-analysis-and-gating.md owns concept roles, fragility, and AND-block admission.",
      "canonical_owner": "references/concept-analysis-and-gating.md",
      "assertions": [
        "essential `and` block",
        "within-block synonym/term only",
        "sensitivity-dangerous optional `and` block",
        "fragility scoring rubric",
        "and-block admission test",
        "default if uncertain"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "candidate.screen-before-mining",
      "rule": "candidate-screening.md owns evidence roles, screening decisions, and discovery/holdout integrity.",
      "canonical_owner": "references/candidate-screening.md",
      "assertions": [
        "discovery record",
        "development-validation record",
        "heuristic neighbor",
        "include`, `exclude`, or `uncertain`",
        "do not feed a related-record set directly to `term-rank`",
        "scripts/candidate_ledger.py",
        "scripts/screening_tool.py",
        "quotation appears verbatim in that field of the hash-bound record",
        "evidence_divergence"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md",
        "references/seed-pmid-validation.md",
        "references/tiab-expansion.md"
      ],
      "guarded_by": "test_screening_decisions_require_verifiable_evidence"
    },
    {
      "id": "candidate.rule-only-cannot-supply-evidence-roles",
      "rule": "candidate-screening.md owns decision provenance: a rule-only screening decision may triage, but cannot supply a discovery or holdout record without adjudication.",
      "canonical_owner": "references/candidate-screening.md",
      "assertions": [
        "`human`, `model`, `rule`, or `human_verified_model`",
        "cannot take `discovery`, `holdout`, or `both`",
        "a rule alone cannot finalise the records the evidence base is built from"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md"
      ],
      "guarded_by": "test_rule_only_screening_cannot_supply_evidence_roles"
    },
    {
      "id": "critic.internal-not-human-press",
      "rule": "press-critic.md owns critic independence, schema, routing, and pass criteria while preserving human PRESS handoff.",
      "canonical_owner": "references/press-critic.md",
      "assertions": [
        "fresh context",
        "reviewed_domains",
        "must-fix",
        "classification",
        "scripts/critic_tool.py",
        "does not constitute press peer review"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "revision.explicit-no-harm-gate",
      "rule": "no-harm-revisions.md owns the mandatory safety proof and fallback disposition for critic and vocabulary revisions.",
      "canonical_owner": "references/no-harm-revisions.md",
      "assertions": [
        "named defect fixed",
        "development-validation retrieval preserved",
        "no unjustified required block",
        "syntax and translation stable",
        "scope unchanged or explicitly versioned",
        "workload effect recorded",
        "revert-to-baseline",
        "experimental-only"
      ],
      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md",
        "references/press-critic.md",
        "references/active-vocabulary-learning.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "goal.tracking-ownership",
      "rule": "goal-tracking.md owns the /goal state machine and completion audit.",
      "canonical_owner": "references/goal-tracking.md",
      "assertions": [
        "goal_requested_intake_pending",
        "goal_active_autonomous",
        "goal_active_blocked",
        "goal_completion_audit",
        "--require-complete-loop"
      ],
      "pointer_locations": [
        "SKILL.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "tools.record-content-saved-json",
      "rule": "mesh-and-pubmed-tools.md owns saved record-content evidence requirements.",
      "canonical_owner": "references/mesh-and-pubmed-tools.md",
      "assertions": [
        "record-content commands",
        "inspect the saved json",
        "--output"
