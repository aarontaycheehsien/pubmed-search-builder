    {
      "id": "framework.methods-evaluation-profile",
      "rule": "methods-evaluation-framework.md owns the method/tool performance-evaluation slot profile, its search defaults, and its ambiguity check.",
      "canonical_owner": "references/methods-evaluation-framework.md",
      "assertions": [
