      "pointer_locations": [
        "SKILL.md",
        "references/workflow.md",
        "references/prisma-s-reporting.md"
      ],
      "guarded_by": "none"
    },
    {
      "id": "prisma-s.item-coverage",
      "rule": "prisma-s-reporting.md owns PRISMA-S mapping and the human peer-review distinction.",
      "canonical_owner": "references/prisma-s-reporting.md",
      "assertions": [
        "prisma-s",
        "item 8. full search strategies",
        "item 14. peer review",
        "do not satisfy item 14"
      ],
      "guarded_by": "none"
    },
    {
      "id": "tiab.objective-term-ranking-and-proximity",
      "rule": "tiab-expansion.md owns screened objective ranking and proximity review.",
      "canonical_owner": "references/tiab-expansion.md",
      "assertions": [
